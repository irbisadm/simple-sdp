{
  "name": "@irbisadm/simple-sdp",
  "version": "1.2.0",
  "license": "MIT",
  "description": "Parse, modify, write and validate SDP (RFC 8866) for WebRTC and SIP. Typed ICE, DTLS, BUNDLE, simulcast, codecs. Zero dependencies.",
  "author": {
    "email": "i@irbisadm.dev",
    "name": "Igor Sheko",
    "url": "https://www.linkedin.com/in/irbisadm/"
  },
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/irbisadm/simple-sdp.git"
  },
  "bugs": "https://github.com/irbisadm/simple-sdp/issues",
  "module": "./dist/index.mjs",
  "main": "./dist/index.mjs",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./wasm": {
      "types": "./wasm/dist/index.d.ts",
      "import": "./wasm/dist/index.mjs",
      "default": "./wasm/dist/index.mjs"
    },
    "./wasm/simple-sdp.wasm": "./wasm/dist/simple-sdp.wasm"
  },
  "sideEffects": false,
  "keywords": [
    "sdp",
    "webrtc",
    "sip",
    "rfc8866",
    "rfc4566",
    "sdp-writer",
    "sdp-validator",
    "sdp-parser",
    "typescript",
    "parser",
    "simulcast",
    "ice",
    "wasm"
  ],
  "files": [
    "./dist/index.mjs",
    "./types/index.d.ts",
    "./wasm/dist/index.mjs",
    "./wasm/dist/index.d.ts",
    "./wasm/dist/simple-sdp.mjs",
    "./wasm/dist/simple-sdp.wasm",
    "./readme.md",
    "./CHANGELOG.md"
  ],
  "devDependencies": {
    "@rollup/plugin-replace": "^5.0.2",
    "@rollup/plugin-terser": "^0.4.0",
    "@rollup/plugin-typescript": "^11.0.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^18.14.0",
    "assemblyscript": "0.28.20",
    "jest": "^29.5.0",
    "rollup": "^3.17.1",
    "rollup-plugin-dts": "^5.2.0",
    "ts-jest": "^29.0.5",
    "tslib": "^2.5.0",
    "typescript": "^5.0.2"
  },
  "engines": {
    "node": ">=17.0.0"
  },
  "scripts": {
    "build": "rollup -c",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "asbuild": "asc --config asconfig.json --target release && node scripts/sync-wasm.mjs",
    "asbuild:debug": "asc --config asconfig.json --target debug",
    "test:wasm": "jest -c jest.wasm.config.js && node test-wasm/npm-entry.mjs",
    "prepack": "yarn asbuild && yarn build"
  }
}
